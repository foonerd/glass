#------ Glass section (x64) -------

# The tap. Every source's stream passes through it byte for byte, in the
# format the player and the output agreed, so PCM, DoP and native DSD stay
# bit-perfect; on the way it is measured, and the peak, RMS and spectrum
# go into a ring under /dev/shm for the display. The tap is a filter
# plugin, so the switch above it may write it by mmap as it does the rest
# of the chain; no side output and no loopback card are needed on x64.
pcm.Glass {
  type glasstap
  slave.pcm "postglass"
  ring "glass"
  fft_size 2048
}

pcm_type.glasstap {
  lib /data/plugins/user_interface/glass/lib/libglasstap.so
}

# ---> Spotify and AirPlay name their own PCMs: the same tap.
pcm.spotify {
  type glasstap
  slave.pcm "postglass"
  ring "glass"
  fft_size 2048
}

pcm.airplay {
  type glasstap
  slave.pcm "postglass"
  ring "glass"
  fft_size 2048
}

# ---> the side outputs of earlier releases, kept as names so an older
# player include still loads; they play nowhere and measure nothing.
pcm.mpd_glass {
  type null
}

pcm.spd_glass {
  type null
}

# needed for some sound cards otherwiese Spotify stops playing after 10 seconds
pcm.copy_output {
  type ${type}
  slave.pcm "postglass"
}

pcm.postglass {
  type empty
  slave.pcm "postGlass"
}
#------ End of Glass section ------
