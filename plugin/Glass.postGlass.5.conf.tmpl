#------ Glass section -------

# ---> pass throught audio pipeline
# if separat alsa pipeline enabled (DSD direct)
pcm.${alsaDirect} {
  type empty
  slave.pcm "postglass"
}

# ---> inline meter for Fusion bridge (no multi, no rate constraint)
pcm.${alsaInlineMeter} {
  type meter
  slave.pcm "postglass"
  scopes.0 glasstap
}

# ---> input from modular alsa 
# duplicate route for meters to play also DSD files
pcm.${alsaMeter} {
  type plug
  route_policy "duplicate"
  slave.channels 4
  slave.pcm {
    type multi

    slaves.a.pcm "postglass"
    slaves.a.channels 2
    slaves.b.pcm "mpd_glass"
    slaves.b.channels 2

    bindings.0 { slave a; channel 0; }
    bindings.1 { slave a; channel 1; }
    bindings.2 { slave b; channel 0; }
    bindings.3 { slave b; channel 1; }
  }
}

# ---> input from the MPD side output
# without audio output (dummy)
pcm.mpd_glass{
	type meter
	slave.pcm "dummy"
	scopes.0 glasstap
}

# ---> separate airplay input
pcm.airplay {
	type meter
	slave.pcm "postglass"
	scopes.0 glasstap
}

# ---> separate spotify input
pcm.${spotDirect} {
  type empty
  slave.pcm "postglass"
}

# spotify with meter using multi/duplicate pattern
# main audio bypasses meter, meter receives duplicate to dummy
# this avoids hw_params issues when meter is inline with main audio
pcm.${spotMeter} {
  type plug
  route_policy "duplicate"
  slave.channels 4
  slave.pcm {
    type multi

    slaves.a.pcm "postglass"
    slaves.a.channels 2
    slaves.b.pcm "spd_glass"
    slaves.b.channels 2

    bindings.0 { slave a; channel 0; }
    bindings.1 { slave a; channel 1; }
    bindings.2 { slave b; channel 0; }
    bindings.3 { slave b; channel 1; }
  }
}

# spotify meter to dummy - side path for meter data only
pcm.spd_glass {
  type meter
  slave.pcm "dummy"
  scopes.0 glasstap
}

# the tap: peak, RMS and the spectrum of what plays, into a ring under /dev/shm
pcm_scope.glasstap {
  type glasstap
  fft_size 2048
  ring "glass"
}

pcm_scope_type.glasstap {
    lib /data/plugins/user_interface/glass/lib/libglasstap.so
}

# null output
pcm.dummy {
  type hw
	card Dummy
	device 0
}

# needed for some sound cards otherwiese Spotify stops playing after 10 seconds
pcm.copy_output {
  type ${type}
  slave.pcm "postglass"
}

pcm.postglass {
  type empty
  slave.pcm "postGlass"
}
#------ End of Glass section ------
